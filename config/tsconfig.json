{
  "compilerOptions": {
    "rootDir": "../src",
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "outDir": "../dist/",
    "checkJs": false,
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "paths": {
      "hooks/*": ["../src/hooks/*"],
      "utils/*": ["../src/utils/*"],
      "styles/*": ["../src/styles/*"],
      "themes/*": ["../src/themes/*"],
      "themes": ["../src/themes"],
      "strings/*": ["../src/strings/*"],
      "types/*": ["../src/types/*"],
      "constants/*": ["../src/constants/*"],
      "lib/*": ["../src/legacy/lib/*"],
      "scripts/*": ["../src/legacy/scripts/*"],
      "components/*": ["../src/legacy/components/*"],
      "elements/*": ["../src/legacy/elements/*"],
      "RootAppRouter": ["../src/RootAppRouter"],
      "apps/*": ["../src/apps/*"]
    }
  },
  "include": [
    "../src"
  ]
}
