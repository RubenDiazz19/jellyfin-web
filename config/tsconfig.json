{
  "compilerOptions": {
    "baseUrl": "../src",
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": "../dist/",
    "checkJs": false,
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "downlevelIteration": true,
    "paths": {
      "hooks/*": ["hooks/*"],
      "utils/*": ["utils/*"],
      "styles/*": ["styles/*"],
      "themes/*": ["themes/*"],
      "themes": ["themes"],
      "strings/*": ["strings/*"],
      "types/*": ["types/*"],
      "constants/*": ["constants/*"],
      "lib/*": ["legacy/lib/*"],
      "scripts/*": ["legacy/scripts/*"],
      "components/*": ["legacy/components/*"],
      "elements/*": ["legacy/elements/*"],
      "RootAppRouter": ["RootAppRouter"],
      "apps/*": ["apps/*"]
    }
  },
  "include": [
    "../src"
  ]
}
