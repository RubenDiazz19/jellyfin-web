:80 {
    root * /usr/share/caddy
    encode gzip

    @backend path /api/* /Audio/* /Videos/* /Images/* /System/* /Users/* /Items/* /Branding/* /DisplayPreferences/* /Music/* /Shows/* /Movies/* /LiveTv/* /Sessions/* /Devices/* /Playback/* /Subtitle/* /web/* /socket/*

    handle @backend {
        reverse_proxy jellyfin-backend:8096
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}
